# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Two dedicated, throw-away Proton test accounts (free plan is fine).
SENDER_EMAIL=your.sender@proton.me
SENDER_PASSWORD=change-me
RECEIVER_EMAIL=your.receiver@proton.me
RECEIVER_PASSWORD=change-me

# Optional
HEADLESS=true            # set false for the first login (CAPTCHA / human verification)
BROWSER=chromium         # chromium | firefox | webkit
TIMEOUT_MS=20000         # default action/assert timeout
MAIL_DELIVERY_TIMEOUT_MS=90000
LOGIN_URL=https://account.proton.me/mail
BASE_URL=https://mail.proton.me
SETTINGS_URL=https://account.proton.me/u/0/mail/filters
